Sub AnimateChart()

    Dim i As Integer

    Range("E2:G13").ClearContents

    For i = 2 To 13

        'Copy month
        Range("E" & i).Value = Range("A" & i).Value
        
        'Copy sales gradually
        Range("F" & i).Value = Range("B" & i).Value
        Range("G" & i).Value = Range("C" & i).Value

        DoEvents

        Application.Wait Now + TimeValue("00:00:01")

    Next i

    MsgBox "Animation Finished"

End Sub
